{
  "name": "priors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/scrape/history-archive.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape": "tsx scripts/scrape/build.ts",
    "library": "tsx scripts/scrape/library.ts",
    "board:try": "tsx scripts/scrape/try-board.ts",
    "test": "vitest run",
    "benchmark:identity": "tsx scripts/benchmarks/run-identity.ts",
    "typecheck": "tsc-rs --noEmit -p .",
    "validate": "npm run ci && npm run build",
    "ci": "next typegen && node scripts/ops/parallel.mjs check:unit check:types check:lint",
    "check:unit": "vitest run",
    "check:types": "tsc-rs --noEmit -p .",
    "check:types:tsc": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/priors/tsc.tsbuildinfo",
    "check:lint": "eslint --cache --cache-location node_modules/.cache/priors/eslint/ src scripts convex",
    "history-archive": "tsx scripts/scrape/history-archive.ts",
    "build:checked": "next typegen && node scripts/ops/parallel.mjs check:unit check:types check:lint build:after-history",
    "build:after-history": "npm run -s history-archive && next build",
    "build:e2e": "npm run -s build:after-history && node scripts/verify/e2e.mjs",
    "prepush:full": "next typegen && node scripts/ops/parallel.mjs check:unit check:types check:lint build:e2e",
    "prepush:light": "next typegen && tsc-rs --noEmit -p .",
    "scrape:now": "bash scripts/ops/scrape-now.sh",
    "smoke": "node scripts/verify/smoke.mjs",
    "interactions": "node scripts/verify/interactions.mjs",
    "e2e": "node scripts/verify/e2e.mjs",
    "assistant-eval": "tsx scripts/assistant-eval/run.mts",
    "cf:build": "node scripts/ops/cloudflare-build.mjs",
    "cf:preview": "node scripts/ops/cloudflare-preview.mjs",
    "cf:deploy": "node scripts/ops/cloudflare-deploy.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "@clerk/shared": "4.43.1",
    "@opennextjs/cloudflare": "1.20.15",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tabler/icons-react": "^3.50.0",
    "convex": "^1.49.0",
    "csv-parse": "7.0.3",
    "echarts": "^6.1.0",
    "hyparquet": "^1.32.0",
    "next": "16.4.5",
    "nuqs": "^2.10.2",
    "posthog-js": "^1.445.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "tsc-rs": "^0.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js-darwin-arm64": "^2.6.2"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "dompurify": "^3.4.17"
  }
}
