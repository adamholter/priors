#!/bin/sh
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
# Vercel runs `npm run ci` as the first step of every build, so a red ci is a failed (billed) deploy.
# Block the push to main instead. Data-only pushes (scrape, snapshots) skip it, like the ignoreCommand does.
while read -r _ local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  range="$local_sha"; git cat-file -e "$remote_sha^{commit}" 2>/dev/null && range="$remote_sha..$local_sha"
  git diff --name-only $range | grep -qvE '^(data/|public/intro/)' || continue
  echo "pre-push: npm run ci (same gate as the Vercel build)..." >&2
  npm run ci >"${TMPDIR:-/tmp}/priors-prepush-ci.log" 2>&1 || { echo "pre-push: npm run ci FAILED. Run it, fix, push again. Not pushing." >&2; exit 1; }
done
exit 0
